{
	"appId": "com.slabcoach.app",
	"appName": "SlabCoach",
	"webDir": "www",
	"server": {
		"url": "https://lockerroom.onrender.com",
		"errorPath": "erreur.html",
		"allowNavigation": [
			"lockerroom.onrender.com",
			"*.ebay.com",
			"*.ebay.ca",
			"signin.ebay.com",
			"auth.ebay.com",
			"auth.sandbox.ebay.com",
			"signin.sandbox.ebay.com"
		]
	},
	"ios": {
		"contentInset": "never",
		"scheme": "SlabCoach",
		"appendUserAgent": "LockerRoomiOS/1.0",
		"backgroundColor": "#0A0D10",
		"limitsNavigationsToAppBoundDomains": false
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 900,
			"launchAutoHide": true,
			"backgroundColor": "#0A0D10",
			"showSpinner": false
		},
		"StatusBar": {
			"style": "DARK",
			"backgroundColor": "#0A0D10",
			"overlaysWebView": true
		},
		"PushNotifications": {
			"presentationOptions": [
				"badge",
				"sound",
				"alert"
			]
		}
	},
	"packageClassList": [
		"AppPlugin",
		"CAPBrowserPlugin",
		"HapticsPlugin",
		"PushNotificationsPlugin",
		"SharePlugin",
		"SplashScreenPlugin",
		"StatusBarPlugin"
	]
}
