{
  "appId": "com.slabcoach.app",
  "appName": "SlabCoach",
  "webDir": "www",
  "server": {
    "url": "https://www.slabcoach.com",
    "errorPath": "erreur.html",
    "allowNavigation": [
      "www.slabcoach.com",
      "appleid.apple.com",
      "*.ebay.com",
      "*.ebay.ca",
      "signin.ebay.com",
      "auth.ebay.com",
      "auth.sandbox.ebay.com",
      "signin.sandbox.ebay.com"
    ]
  },
  "ios": {
    "contentInset": "never",
    "scheme": "SlabCoach",
    "appendUserAgent": "LockerRoomiOS/1.0",
    "backgroundColor": "#0B0B0E",
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 900,
      "launchAutoHide": true,
      "backgroundColor": "#0B0B0E",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0B0B0E",
      "overlaysWebView": true
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  }
}